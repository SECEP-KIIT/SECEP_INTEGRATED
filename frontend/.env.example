# Copy to .env.local for local development. Never commit .env files.
# Dev-only flags. Not part of SRS §6.8 and never read by production builds.

# 1 = serve the API from MSW mocks (src/mocks) instead of the backend on :4000.
VITE_MOCK=1

# The mock keeps what you change (prefs, read state, actions, corrections, layouts…) across reloads by default.
# 0 = reseed on every reload instead. Versioned: an incompatible saved store is discarded and reseeded.
# Fake secrets are never saved.
VITE_MOCK_PERSIST=1
