# Copy to .env for local development. Never commit .env.
# Keys and meanings: SRS §6.8. Production values come from docker-compose (M0).

# Dev only; the API listens on 4000 in every environment (SRS §6.2).
PORT=4000

# Where the app is served. In dev, the Vite server (it proxies /api to this API).
PUBLIC_BASE_URL=http://localhost:5173

# From the organization's Google Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secrets are read from files, never put inline. backend/secrets/ is git-ignored.
MASTER_KEY_FILE=./secrets/master_key
JWT_SECRET_FILE=./secrets/jwt_secret

DATABASE_URL=postgres://secep:secep@localhost:5432/secep

# Dev/demo only (never in production): sign in by email at /api/v1/auth/dev without Google, for the seeded
# Northwind mailbox. With no GOOGLE_CLIENT_ID, "Sign in with Google" goes there instead.
DEV_LOGIN=1
# 1 (default): without Jira settings in the tenant, Jira issues and Calendar events are simulated locally.
SIMULATE_INTEGRATIONS=1
REDIS_URL=redis://localhost:6379/0

# Should features (S). Uncomment when the feature is built.
# FILES_DIR=./data/files
# MAX_UPLOAD_MB=25
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY_FILE=./secrets/vapid_private
# VAPID_SUBJECT=mailto:admin@example.com
# JIRA_STATUS_POLL_S=120
# CALENDAR_SYNC_S=300
# REMINDER_TICK_S=15
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
